using System;
using System.Collections.Generic;

namespace Bench
{
    interface IShape
    {
        double Area();
        double Perimeter();
    }

    abstract class Shape : IShape
    {
        public abstract double Area();
        public abstract double Perimeter();
        public virtual double Weight() => Area() * 0.5;
    }

    class Circle : Shape
    {
        double r;
        public Circle(double r) { this.r = r; }
        public override double Area() => 3.141592653589793 * r * r;
        public override double Perimeter() => 2 * 3.141592653589793 * r;
    }

    class Rect : Shape
    {
        double w, h;
        public Rect(double w, double h) { this.w = w; this.h = h; }
        public override double Area() => w * h;
        public override double Perimeter() => 2 * (w + h);
        public override double Weight() => Area();
    }

    sealed class Square : Rect
    {
        public Square(double s) : base(s, s) {}
    }

    class Program
    {
        static void Main()
        {
            var shapes = new List<IShape>();
            var all = new List<Shape>();
            for (int i = 0; i < 1000; i++)
            {
                Shape s;
                if (i % 3 == 0) s = new Circle(i % 17 + 1);
                else if (i % 3 == 1) s = new Rect(i % 13 + 1, i % 7 + 1);
                else s = new Square(i % 11 + 1);
                shapes.Add(s);
                all.Add(s);
            }
            double a = 0, w = 0;
            for (int rep = 0; rep < 20000; rep++)
            {
                foreach (var s in shapes) a += s.Area() - s.Perimeter() * 0.001;
                for (int i = 0; i < all.Count; i++) w += all[i].Weight();
            }
            Console.WriteLine(a.ToString("F3"));
            Console.WriteLine(w.ToString("F3"));
        }
    }
}
