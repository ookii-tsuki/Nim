using System;
using System.Collections.Generic;
using Demo.Tools;

namespace Demo.Tools
{
    public static class StringExt
    {
        public static string Shout(this string s, int n) => s.ToUpper() + new string('!', n);
        public static bool IsBlank(this string s) => s == null || s.Length == 0;
    }

    public static class ListExt
    {
        public static T Second<T>(this List<T> xs) => xs[1];
        public static int Total(this List<int> xs)
        {
            int t = 0;
            foreach (var x in xs) t += x;
            return t;
        }
    }
}

namespace Demo
{
    class Point
    {
        public int X;
        public int Y;
        public Point(int x, int y) { X = x; Y = y; }
    }

    static class PointExt
    {
        public static int Manhattan(this Point p) => Math.Abs(p.X) + Math.Abs(p.Y);
        public static Point Scale(this Point p, int k) => new Point(p.X * k, p.Y * k);
        public static string Describe(this Point p) => p == null ? "no point" : "(" + p.X + "," + p.Y + ")";
    }

    static class Counter
    {
        static int count;
        public const int Step = 2;
        public static int Next() { count += Step; return count; }
        public static int Twice(this int x) => x * 2;
    }

    class Program
    {
        static void Main()
        {
            Console.WriteLine("hi".Shout(3));
            Console.WriteLine(StringExt.Shout("yo", 1));
            Console.WriteLine("".IsBlank());
            var p = new Point(3, -4);
            Console.WriteLine(p.Manhattan());
            Console.WriteLine(p.Scale(2).Describe());
            Point none = null;
            Console.WriteLine(none.Describe());
            var xs = new List<int> { 5, 6, 7 };
            Console.WriteLine(xs.Second());
            Console.WriteLine(xs.Total());
            Console.WriteLine(new List<string> { "a", "b" }.Second());
            Console.WriteLine(Counter.Next() + Counter.Next());
            Console.WriteLine(21.Twice());
            Console.WriteLine(Counter.Twice(5).Twice());
        }
    }
}
