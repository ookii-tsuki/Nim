using System;

namespace Demo
{
    class Program
    {
        static void Main()
        {
            int n = 3;
            int fact = 1;
            while (n > 0)
            {
                fact = fact * n;
                n = n - 1;
            }
            Console.WriteLine(fact);

            if (fact == 6)
            {
                Console.WriteLine("six");
            }
            else
            {
                Console.WriteLine("other");
            }

            int total = 0;
            total += 5;
            total += 10;
            Console.WriteLine(total);
        }
    }
}
