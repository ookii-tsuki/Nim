using System;

namespace Demo
{
    class Point
    {
        public int X { get; set; }
        public int Y { get; set; }
    }

    class Program
    {
        static void Main()
        {
            Point p = new Point();
            p.X = 3;
            p.Y = 4;
            Console.WriteLine(p.X + p.Y);
        }
    }
}
