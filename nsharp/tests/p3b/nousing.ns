using System;

namespace Demo
{
    // Negative case: `List<T>` needs `using System.Collections.Generic;`, which this
    // file lacks. The directive lowers to `import "System/Collections/Generic"`. The
    // C# compiler rejects this too, with CS0246.
    class Program
    {
        static void Main()
        {
            List<int> nums = new List<int>();
            nums.Add(1);
            Console.WriteLine(nums.Count);
        }
    }
}
