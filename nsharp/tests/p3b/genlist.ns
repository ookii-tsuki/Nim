using System;
using System.Collections.Generic;

namespace Demo
{
    class Program
    {
        static bool IsEven(int x)
        {
            return x % 2 == 0;
        }

        static bool IsBig(int x)
        {
            return x > 100;
        }

        static int Descending(int a, int b)
        {
            return b - a;
        }

        static string Tag(int x)
        {
            return "#" + x;
        }

        static void Print(int x)
        {
            Console.WriteLine("item " + x);
        }

        static void Main()
        {
            List<int> xs = new List<int>();
            xs.Add(5);
            xs.Add(2);
            xs.Add(8);

            // A List is a class: both names see the same list.
            List<int> alias = xs;
            alias.Add(1);
            Console.WriteLine(xs.Count);
            List<int> none = null;
            Console.WriteLine(none == null);

            xs[0] += 10;
            Console.WriteLine(xs[0]);

            Predicate<int> even = IsEven;
            Predicate<int> big = IsBig;
            Console.WriteLine(xs.FindIndex(even));
            Console.WriteLine(xs.FindLastIndex(even));
            Console.WriteLine(xs.Find(even));
            Console.WriteLine(xs.FindLast(even));
            Console.WriteLine(xs.Find(big));
            Console.WriteLine(xs.Exists(big));
            Console.WriteLine(xs.TrueForAll(even));
            List<int> evens = xs.FindAll(even);
            Console.WriteLine(evens.Count);

            Action<int> print = Print;
            xs.ForEach(print);

            Converter<int, string> tag = Tag;
            List<string> tags = xs.ConvertAll(tag);
            Console.WriteLine(tags[0]);

            Comparison<int> desc = Descending;
            xs.Sort(desc);
            Console.WriteLine(xs[0]);
            xs.Sort();
            Console.WriteLine(xs[0]);
            Console.WriteLine(xs.BinarySearch(8));
            Console.WriteLine(xs.BinarySearch(3));

            List<int> copy = new List<int>(xs);
            copy.AddRange(xs);
            Console.WriteLine(copy.Count);
            copy.RemoveRange(0, 4);
            Console.WriteLine(copy.Count);
            copy.InsertRange(1, xs);
            Console.WriteLine(copy.Count);
            Console.WriteLine(copy.IndexOf(15, 2));
            Console.WriteLine(copy.LastIndexOf(1));
            Console.WriteLine(copy.RemoveAll(even));
            Console.WriteLine(copy.Count);

            List<int> mid = xs.GetRange(1, 2);
            Console.WriteLine(mid[0] + mid[1]);

            int[] arr = xs.ToArray();
            Console.WriteLine(arr.Length);
            int[] buffer = new int[6];
            xs.CopyTo(buffer, 2);
            Console.WriteLine(buffer[2]);

            xs.Reverse();
            Console.WriteLine(xs[0]);
            xs.Insert(0, 42);
            xs.RemoveAt(1);
            Console.WriteLine(xs[0] + xs[1]);

            try
            {
                Console.WriteLine(xs[99]);
            }
            catch (ArgumentOutOfRangeException e)
            {
                Console.WriteLine("out of range");
            }

            try
            {
                foreach (int x in xs)
                {
                    xs.Add(x);
                }
            }
            catch (InvalidOperationException e)
            {
                Console.WriteLine(e.Message);
            }

            xs.Clear();
            Console.WriteLine(xs.Count);
            Console.WriteLine(alias.Count);
        }
    }
}
