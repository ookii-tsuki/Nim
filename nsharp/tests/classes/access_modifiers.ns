// `protected internal` and `private protected` members, read and overridden from
// a derived class.
using System;
namespace Demo
{
    class Base
    {
        protected internal int A = 1;
        private protected int B = 2;
        protected internal virtual string Who() => "base";
    }
    class Derived : Base
    {
        public int Sum() => A + B;
        protected internal override string Who() => "derived";
    }
    class Program
    {
        static void Main()
        {
            var d = new Derived();
            Console.WriteLine(d.Sum() + d.A);
            Console.WriteLine(d.Who());
        }
    }
}
