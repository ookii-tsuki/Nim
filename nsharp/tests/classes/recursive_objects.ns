// A recursively built tree of objects: constructor arguments (strings included)
// arrive intact, and a call on a null receiver, direct or through a field, throws
// NullReferenceException.
using System;
namespace Demo
{
    class Node
    {
        public Node Left, Right;
        public string Name;
        public Node(Node l, Node r, string name) { Left = l; Right = r; Name = name; }
        public int Count() => Left == null ? 1 : 1 + Left.Count() + Right.Count();
    }
    class Program
    {
        static Node Make(int d) => d == 0 ? new Node(null, null, "leaf") : new Node(Make(d - 1), Make(d - 1), "n" + d);

        static void Main()
        {
            var t = Make(3);
            Console.WriteLine(t.Count());
            Console.WriteLine(t.Name + " " + t.Left.Name + " " + t.Left.Left.Left.Name);
            string keep = "kept";
            var k = new Node(null, null, keep);
            Console.WriteLine(keep + " " + k.Name);

            Node none = null;
            try { Console.WriteLine(none.Count()); }
            catch (NullReferenceException) { Console.WriteLine("null receiver"); }
            try { Console.WriteLine(t.Left.Left.Left.Left.Count()); }
            catch (NullReferenceException) { Console.WriteLine("null field receiver"); }
        }
    }
}
