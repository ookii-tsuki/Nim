using System;

namespace Demo
{
    class Item
    {
        public int Id;
    }

    class Program
    {
        static void Main()
        {
            string name = "Hello, World";

            Console.WriteLine(name.Length);
            int len = name.Length;
            Console.WriteLine(len);
            Console.WriteLine(name.ToUpper());
            Console.WriteLine(name.ToLower());
            Console.WriteLine(name.Substring(7));
            Console.WriteLine(name.Substring(0, 5));
            Console.WriteLine(name.Contains("World"));
            Console.WriteLine(name.StartsWith("Hello"));
            Console.WriteLine(name.EndsWith("d"));
            Console.WriteLine(name.IndexOf('W'));
            Console.WriteLine(name.Replace("World", "N#"));

            Console.WriteLine(String.IsNullOrEmpty(""));
            Console.WriteLine(String.IsNullOrEmpty("x"));
            Console.WriteLine(String.Concat("a", "b"));

            int[] xs = new int[] { 10, 20, 30 };
            Console.WriteLine(xs.Length);
            Console.WriteLine(Array.IndexOf(xs, 20));

            Item a = new Item();
            Item b = a;
            Console.WriteLine(Object.ReferenceEquals(a, b));
            Console.WriteLine(a.Equals(b));
        }
    }
}