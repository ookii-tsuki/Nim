// The runtime's own errors, caught by their .NET exception types.
using System;

namespace Demo
{
    class Gadget
    {
        public int Size;
        public int Ignore() { return 7; }
    }

    class Program
    {
        static void Main()
        {
            int[] a = new int[2];
            try
            {
                Console.WriteLine(a[5]);
            }
            catch (IndexOutOfRangeException e)
            {
                Console.WriteLine("index");
            }

            Gadget g = null;
            try
            {
                Console.WriteLine(g.Size);
            }
            catch (NullReferenceException e)
            {
                Console.WriteLine("null deref");
            }

            try
            {
                Console.WriteLine(g.Ignore());
            }
            catch (NullReferenceException e)
            {
                Console.WriteLine("null call");
            }

            int m = 2147483647;
            try
            {
                checked
                {
                    Console.WriteLine(m + 1);
                }
            }
            catch (OverflowException e)
            {
                Console.WriteLine("overflow");
            }

            int z = 0;
            try
            {
                Console.WriteLine(10 / z);
            }
            catch (DivideByZeroException e)
            {
                Console.WriteLine("zero");
            }

            try
            {
                throw new ArgumentException("bad");
            }
            catch (Exception e)
            {
                Console.WriteLine(e.Message);
            }

            Console.WriteLine("done");
        }
    }
}
