// The argument checks of .NET 6 and 8 (ArgumentNullException.ThrowIfNull,
// ArgumentOutOfRangeException.ThrowIfNegative, ...): an argument that fails throws,
// naming the parameter after the text the argument was written with, as C#'s
// [CallerArgumentExpression] passes it; one that passes does nothing.
using System;
namespace Demo {
  class Program {
    static void Main() {
      string s = null;
      object o = new object();
      int n = -3;
      ArgumentNullException.ThrowIfNull(o);
      try { ArgumentNullException.ThrowIfNull(s); }
      catch (ArgumentNullException e) { Console.WriteLine(e.ParamName + " [" + e.Message + "]"); }
      try { ArgumentException.ThrowIfNullOrEmpty(""); }
      catch (ArgumentException e) { Console.WriteLine(e.GetType().Name + " [" + e.Message + "]"); }
      try { ArgumentException.ThrowIfNullOrWhiteSpace("  "); }
      catch (ArgumentException e) { Console.WriteLine("[" + e.Message + "]"); }
      ArgumentOutOfRangeException.ThrowIfNegative(5);
      try { ArgumentOutOfRangeException.ThrowIfNegative(n); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine(e.ParamName + " " + e.ActualValue + " [" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfZero(0); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfNegativeOrZero(n); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfGreaterThan(n, -5); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfGreaterThanOrEqual(n + 1, n + 1); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfLessThan(n, 0); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfLessThanOrEqual(n, n); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfEqual(n, -3); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentOutOfRangeException.ThrowIfNotEqual(n, 7); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ArgumentException.ThrowIfNullOrEmpty(argument: ""); }
      catch (ArgumentException e) { Console.WriteLine(e.ParamName); }
      try { ArgumentOutOfRangeException.ThrowIfGreaterThan(other: 1, value: n + 9); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine(e.ParamName); }
      try { ArgumentOutOfRangeException.ThrowIfNegative(n /* comment */); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine(e.ParamName); }
      try { ArgumentOutOfRangeException.ThrowIfNegative((n)); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine(e.ParamName); }
      try { ArgumentOutOfRangeException.ThrowIfLessThanOrEqual(2.5, 3.0); }
      catch (ArgumentOutOfRangeException e) { Console.WriteLine("[" + e.Message + "]"); }
      try { ObjectDisposedException.ThrowIf(true, "text"); }
      catch (ObjectDisposedException e) { Console.WriteLine(e.ObjectName); }
      try { ObjectDisposedException.ThrowIf(true, o); }
      catch (ObjectDisposedException e) { Console.WriteLine("[" + e.Message + "] " + e.ObjectName); }
      ObjectDisposedException.ThrowIf(false, o);
      Console.WriteLine("done");
    }
  }
}
