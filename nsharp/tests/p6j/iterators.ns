using System;
using System.Collections.Generic;

namespace Demo
{
    class Range
    {
        int lo;
        int hi;
        public Range(int lo, int hi) { this.lo = lo; this.hi = hi; }
        public IEnumerator<int> GetEnumerator()
        {
            for (int i = lo; i < hi; i++) yield return i;
        }
    }

    class Countdown
    {
        int n;
        public Countdown(int n) { this.n = n; }
        public CountdownEnumerator GetEnumerator() { return new CountdownEnumerator(n); }
    }

    class CountdownEnumerator
    {
        int cur;
        public CountdownEnumerator(int start) { cur = start + 1; }
        public bool MoveNext() { cur--; return cur > 0; }
        public int Current { get { return cur; } }
    }

    class Bag
    {
        List<string> items = new List<string>();
        public void Add(string s) { items.Add(s); }
        public IEnumerable<string> Shouted()
        {
            foreach (var s in items) yield return s.ToUpper();
        }
    }

    class Program
    {
        static IEnumerable<int> Evens(int limit)
        {
            for (int i = 0; ; i += 2)
            {
                if (i > limit) yield break;
                yield return i;
            }
        }

        static IEnumerable<T> Repeat<T>(T x, int n)
        {
            for (int i = 0; i < n; i++) yield return x;
        }

        static IEnumerable<int> Noisy()
        {
            Console.WriteLine("start");
            yield return 1;
            Console.WriteLine("middle");
            yield return 2;
            Console.WriteLine("end");
        }

        static IEnumerable<int> Guarded()
        {
            try
            {
                yield return 1;
                yield return 2;
            }
            finally
            {
                Console.WriteLine("cleanup");
            }
        }

        static int Sum(IEnumerable<int> xs)
        {
            int total = 0;
            foreach (int x in xs) total += x;
            return total;
        }

        static void Main()
        {
            foreach (int e in Evens(7)) Console.Write(e + " ");
            Console.WriteLine();
            var evens = Evens(4);
            Console.WriteLine(Sum(evens) + Sum(evens));
            foreach (var s in Repeat("ab", 3)) Console.Write(s);
            Console.WriteLine();
            foreach (var i in new Range(2, 5)) Console.Write(i * 10 + ",");
            Console.WriteLine();
            foreach (var c in new Countdown(3)) Console.Write(c);
            Console.WriteLine();
            var lazy = Noisy();
            Console.WriteLine("made");
            foreach (var v in lazy)
            {
                Console.WriteLine("got " + v);
                if (v == 2) break;
            }
            foreach (var g in Guarded()) Console.WriteLine("guarded " + g);
            var bag = new Bag();
            bag.Add("x");
            bag.Add("y");
            foreach (var s in bag.Shouted()) Console.Write(s);
            Console.WriteLine();
            Console.WriteLine(Sum(new List<int> { 1, 2, 3 }));
            Console.WriteLine(Sum(new int[] { 4, 5 }));
            IEnumerable<int> Squares(int n)
            {
                for (int k = 1; k <= n; k++) yield return k * k;
            }
            foreach (var q in Squares(4)) Console.Write(q + " ");
            Console.WriteLine();
            IEnumerator<int> en = Evens(2).GetEnumerator();
            while (en.MoveNext()) Console.Write(en.Current);
            Console.WriteLine();
            var copy = new List<int>(Evens(6));
            Console.WriteLine(copy.Count);
        }
    }
}
