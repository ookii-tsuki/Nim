using System;

namespace Demo
{
    class Base
    {
        // `virtual` on an instance method: a dispatch slot, lowered to a Nim
        // `method {.base.}`.
        public virtual void Speak()
        {
            Console.WriteLine("base");
        }
    }

    class Program
    {
        static void Main()
        {
            Base b = new Base();
            b.Speak();
        }
    }
}