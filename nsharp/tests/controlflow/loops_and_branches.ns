// while, do-while with continue and break, for, if/else, compound assignment,
// and checked/unchecked blocks used as plain statements.
using System;
namespace Demo
{
    class Program
    {
        static void Main()
        {
            int n = 3;
            int fact = 1;
            while (n > 0)
            {
                fact = fact * n;
                n = n - 1;
            }
            Console.WriteLine(fact);
            if (fact == 6)
            {
                Console.WriteLine("six");
            }
            else
            {
                Console.WriteLine("other");
            }
            int total = 0;
            total += 5;
            total += 10;
            Console.WriteLine(total);

            int sum = 0;
            for (int i = 1; i <= 10; i++)
            {
                sum = sum + i;
            }
            Console.WriteLine(sum);
            Console.WriteLine(sum > 50);

            int j = 0;
            do
            {
                j++;
                if (j == 2) { continue; }
                Console.WriteLine("do " + j);
            }
            while (j < 3);
            int k = 0;
            do
            {
                k++;
                if (k == 2) { break; }
                Console.WriteLine("brk " + k);
            }
            while (k < 5);
            checked
            {
                Console.WriteLine("checked block");
            }
            unchecked
            {
                Console.WriteLine("unchecked block");
            }
        }
    }
}
