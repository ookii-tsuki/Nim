// The Try* members of the queues and the stack, and Dictionary.Remove handing
// back the value it removed.
using System;
using System.Collections.Generic;

namespace Demo {
    class Program {
        static void Main() {
            var q = new Queue<int>();
            q.Enqueue(1); q.Enqueue(2);
            int x;
            Console.WriteLine(q.TryPeek(out x) + " " + x + " " + q.Count);
            Console.WriteLine(q.TryDequeue(out x) + " " + x + " " + q.Count);
            Console.WriteLine(q.TryDequeue(out x) + " " + x);
            Console.WriteLine(q.TryDequeue(out x) + " " + x + " " + q.TryPeek(out x) + " " + x);

            var s = new Stack<string>();
            s.Push("a"); s.Push("b");
            string t;
            Console.WriteLine(s.TryPeek(out t) + " " + t);
            Console.WriteLine(s.TryPop(out t) + " " + t + " " + s.Count);
            Console.WriteLine(s.TryPop(out t) + " " + t);
            Console.WriteLine(s.TryPop(out t) + " [" + t + "]");

            var pq = new PriorityQueue<string, int>();
            pq.Enqueue("low", 5); pq.Enqueue("high", 1);
            string e; int p;
            Console.WriteLine(pq.TryPeek(out e, out p) + " " + e + " " + p);
            Console.WriteLine(pq.TryDequeue(out e, out p) + " " + e + " " + p + " " + pq.Count);
            Console.WriteLine(pq.TryDequeue(out e, out p) + " " + e + " " + p);
            Console.WriteLine(pq.TryDequeue(out e, out p) + " [" + e + "] " + p);

            var d = new Dictionary<string, int> { { "one", 1 }, { "two", 2 } };
            int v;
            Console.WriteLine(d.Remove("one", out v) + " " + v + " " + d.Count);
            Console.WriteLine(d.Remove("one", out v) + " " + v + " " + d.Count);
            Console.WriteLine(d.Remove("two") + " " + d.Count);
        }
    }
}
