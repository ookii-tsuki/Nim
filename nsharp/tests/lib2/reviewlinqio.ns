// LINQ, collection and IO behaviour a review found differing from .NET: keys
// computed once per element, Zip in step, NaN and null in Min/Max, checked
// Average, removing from a dictionary while enumerating it, File.Move, and
// closed readers and writers.
using System;
using System.Linq;
using System.Collections.Generic;
using System.IO;
namespace Demo {
class Person { public string Name; public int Age; public Person(string n, int a) { Name = n; Age = a; } }
class Program {
    static void T(Action f) { try { f(); } catch (Exception e) { Console.WriteLine(e.GetType().Name + ": " + e.Message.Replace("\n", "|").Replace(Path.GetTempPath(), "<tmp>/")); } }
    static int calls = 0;
    static int Tick(int x) { calls++; return x; }
    static void Main() {
        T(() => Console.WriteLine(string.Join(",", new[] { 1, 2, 3, 4 }.SkipLast(-1))));
        T(() => Console.WriteLine(string.Join(",", new[] { 1, 2, 3, 4 }.TakeLast(-1)) + "|"));
        var a = new[] { 1, 2, 3, 4 };
        var two = new[] { 10, 20 };
        T(() => Console.WriteLine(string.Join(",", two.Zip(a.Select(x => Tick(x)), (p, q) => p + q)) + " calls=" + calls));
        int keys = 0;
        var sorted = new[] { 3, 1, 4, 1 }.OrderBy(x => { keys++; return x; }).ThenByDescending(x => { keys++; return -x; }).ToList();
        Console.WriteLine(string.Join(",", sorted) + " keys=" + keys);
        Console.WriteLine(string.Join(",", new[] { "b", "a", "c" }.Order()) + " " + string.Join(",", new[] { 2, 9, 5 }.OrderDescending()));
        var people = new List<Person> { new Person("x", 3), new Person("y", 1), new Person("z", 3) };
        Console.WriteLine(string.Join(",", people.OrderByDescending(p => p.Age).ThenBy(p => p.Name).Select(p => p.Name)));
        T(() => Console.WriteLine(new[] { 1.0, double.NaN, 3.0 }.Min()));
        T(() => Console.WriteLine(new[] { 1.0, double.NaN, 3.0 }.Max()));
        T(() => Console.WriteLine(new List<Person>().MinBy(p => p.Age) == null));
        T(() => Console.WriteLine(new List<Person>().MaxBy(p => p.Age) == null));
        T(() => Console.WriteLine(new List<int>().Min()));
        T(() => Console.WriteLine(new string[0].Min() == null));
        T(() => Console.WriteLine(new long[] { long.MaxValue, 1 }.Average()));
        T(() => Console.WriteLine(new[] { 1, 2 }.Average()));
        T(() => Console.WriteLine(new float[] { 1.5f, 2.5f }.Average()));
        T(() => Console.WriteLine(people.Average(p => p.Age)));
        var d = new Dictionary<string, int> { { "a", 1 }, { "b", 2 }, { "c", 3 } };
        foreach (var kv in d) { int v; d.Remove(kv.Key, out v); }
        Console.WriteLine(d.Count);
        var d2 = new Dictionary<int, int> { { 1, 1 }, { 2, 2 } };
        foreach (var k in d2.Keys) d2.Remove(k);
        Console.WriteLine(d2.Count);
        string dir = Path.Combine(Path.GetTempPath(), "nsfix_move");
        if (Directory.Exists(dir)) Directory.Delete(dir, true);
        Directory.CreateDirectory(dir);
        File.WriteAllText(Path.Combine(dir, "a"), "1");
        File.WriteAllText(Path.Combine(dir, "b"), "2");
        T(() => File.Move(Path.Combine(dir, "a"), Path.Combine(dir, "b")));
        T(() => File.Move(Path.Combine(dir, "a"), Path.Combine(dir, "no/b")));
        var w = new StreamWriter(Path.Combine(dir, "w")); w.Close();
        T(() => w.Write(1));
        var r = new StreamReader(Path.Combine(dir, "w")); r.Close();
        T(() => r.ReadLine());
        Directory.Delete(dir, true);
    }
}
}
