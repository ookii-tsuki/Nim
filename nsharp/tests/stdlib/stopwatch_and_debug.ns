// System.Diagnostics: a Stopwatch's states, and Debug's members, which write
// nothing to stdout.
using System;
using System.Diagnostics;

namespace Demo {
class Program {
    static void Main() {
        var sw = Stopwatch.StartNew();
        Console.WriteLine(sw.IsRunning);
        long s = 0; for (int i = 0; i < 100000; i++) s += i;
        sw.Stop();
        Console.WriteLine(s + " " + sw.IsRunning + " " + (sw.ElapsedTicks >= 0) + " " + (sw.ElapsedMilliseconds >= 0) + " " + (sw.Elapsed >= TimeSpan.Zero));
        long t1 = sw.ElapsedTicks;
        Console.WriteLine(sw.ElapsedTicks == t1);
        sw.Reset();
        Console.WriteLine(sw.ElapsedTicks + " " + sw.IsRunning);
        sw.Restart();
        sw.Start();
        Console.WriteLine(sw.IsRunning + " " + (Stopwatch.Frequency > 0) + " " + (Stopwatch.GetTimestamp() > 0));
        var sw2 = new Stopwatch();
        Console.WriteLine(sw2.Elapsed);
        Debug.Assert(s > 0);
        Debug.Assert(true, "never shown");
        Debug.WriteLine("to the debug listener, not stdout");
        Debug.Write(42);
    }
}
}
