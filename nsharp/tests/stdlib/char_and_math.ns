// char's classification and case members, and the Math members beyond the first
// set: Clamp, Truncate, Round to digits, logarithms, trigonometry and constants.
using System;

namespace Demo
{
    class Program
    {
        static void Fails(Action f) { try { f(); } catch (Exception e) { Console.WriteLine(e.GetType().Name + ": " + e.Message.Replace("\n", "|")); } }
        static void Main()
        {
            foreach (var ch in "a1 Z.$\t")
                Console.WriteLine((int)ch + ": " + char.IsDigit(ch) + char.IsLetter(ch) + char.IsLetterOrDigit(ch) +
                    char.IsUpper(ch) + char.IsLower(ch) + char.IsWhiteSpace(ch) + char.IsPunctuation(ch) +
                    char.IsSymbol(ch) + char.IsControl(ch) + " " + char.ToUpper(ch) + char.ToLower(ch));
            Console.WriteLine(char.GetNumericValue('7') + " " + Char.IsDigit('x'));

            Console.WriteLine(Math.Clamp(15, 0, 10) + " " + Math.Clamp(-2.5, -1.0, 1.0) + " " + Math.Truncate(-2.7) + " " + Math.Round(2.675, 2) + " " + Math.Round(1.005, 2) + " " + Math.Round(-1.25, 1));
            Console.WriteLine(Math.Sign(-4L) + " " + Math.Abs(-2.5f) + " " + Math.Log(Math.E) + " " + Math.Log(8, 2) + " " + Math.Log10(1000) + " " + Math.Log2(16) + " " + Math.Exp(0) + " " + Math.Cbrt(27));
            Console.WriteLine(Math.Sin(0) + " " + Math.Cos(0) + " " + Math.Tan(0) + " " + Math.Atan2(1, 1) * 4 + " " + Math.PI + " " + Math.Tau + " " + Math.Asin(1) * 2 + " " + Math.Acos(1) + " " + Math.Atan(0) + " " + Math.Tanh(0));
            try { Math.Clamp(1, 5, 2); } catch (ArgumentException e) { Console.WriteLine(e.Message); }
            // Argument checks: .NET's exception type and message.
            Fails(() => Console.WriteLine(Math.Log(2, 1) + " " + Math.Log(2, 0) + " " + Math.Log(2, double.PositiveInfinity) + " " + Math.Log(1, 0) + " " + Math.Log(double.NaN, 1) + " " + Math.Log(8, 2)));
        }
    }
}
