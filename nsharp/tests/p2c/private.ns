using System;

namespace Demo
{
    class Base
    {
        int secret;

        public Base(int s) { secret = s; }

        public int GetSecret() { return secret; }
    }

    class Derived : Base
    {
        // The next two lines must NOT compile: `secret` is private in Base.
        public Derived(int s) { this.secret = s; }

        public int Leak() { return secret; }
    }

    class Program
    {
        static void Main()
        {
            Console.WriteLine("should not compile");
        }
    }
}
