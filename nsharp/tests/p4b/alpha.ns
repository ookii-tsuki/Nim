// Two namespaces that use each other, as C# allows: their generated modules
// import one another as an import cycle (`{.cyclic.}`). Types, inheritance,
// generics, enums and calls go both ways.
using System;
using Beta;

namespace Alpha
{
    enum Mood { Calm, Loud }

    class A
    {
        public B peer;
        public Mood mood = Mood.Calm;
        public virtual string Name() => "A";
        public string Greet(B b) => Name() + " greets " + b.Name() + " (" + b.Mood + ")";
        public static int Count;
    }

    class Holder<T> where T : A
    {
        public T Item;
        public Holder(T item) { Item = item; }
        public string Show() => "holder of " + Item.Name();
    }
}
