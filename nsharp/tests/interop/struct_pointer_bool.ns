// A pointer to a struct with a bool field: its C mirror stores the bool as a
// 4-byte BOOL, so it is not the struct's unmanaged layout.
using System;

namespace Demo
{
    struct Flagged
    {
        public int Id;
        public bool On;
    }

    unsafe class Program
    {
        static void Main()
        {
            Flagged* p = null;
            Console.WriteLine(p == null);
        }
    }
}
