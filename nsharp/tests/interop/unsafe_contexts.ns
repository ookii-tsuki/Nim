// Pointers are allowed in an unsafe context only: an `unsafe` type, member, local
// function or block, as in C#.
using System;

namespace Demo
{
    unsafe struct Cell
    {
        public int Value;
        public int* Next;
    }

    unsafe class Outer
    {
        // A nested type is inside the unsafe type's text.
        public static class Inner
        {
            public static int Read(int* p) => *p;
        }
    }

    class Counter { public int Hits; }

    struct Pair { public int A; public int B; }

    class Program
    {
        static int s_total = 40;

        static unsafe int Sum(int* p, int n)
        {
            int s = 0;
            for (int i = 0; i < n; i++) s += p[i];
            return s;
        }

        static void Main()
        {
            int[] xs = { 1, 2, 3, 4 };
            int total;
            unsafe
            {
                fixed (int* p = xs) total = Sum(p, xs.Length);
            }
            Console.WriteLine(total);

            int y = 5;
            unsafe int Twice(int* q) => *q * 2;
            unsafe { Console.WriteLine(Twice(&y) + Outer.Inner.Read(&y)); }

            unsafe
            {
                Cell c = new Cell();
                c.Value = 7;
                c.Next = &y;
                Console.WriteLine(c.Value + *c.Next + " " + (sizeof(Cell) >= 12));

                // A moveable variable's address is taken in a `fixed` initialiser; a
                // local's, a field of a local struct's, and a pointer's target's anywhere.
                var counter = new Counter();
                fixed (int* h = &counter.Hits) *h = 3;
                fixed (int* t = &s_total) *t += 2;
                fixed (int* e = &xs[1]) *e = 20;
                Pair pair = new Pair();
                int* pb = &pair.B;
                *pb = 9;
                int* back = &*pb;
                Console.WriteLine(counter.Hits + " " + s_total + " " + xs[1] + " " + pair.B + " " + *back);
            }
        }
    }
}
