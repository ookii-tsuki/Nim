using System;
namespace Demo
{
    class Program
    {
        static int Sum(int[,] g)
        {
            int s = 0;
            for (int i = 0; i < g.GetLength(0); i++)
                for (int j = 0; j < g.GetLength(1); j++)
                    s += g[i, j];
            return s;
        }
        static void Main()
        {
            int[,] grid = new int[3, 4];
            grid[1, 2] = 7;
            grid[2, 3] += 5;
            Console.WriteLine(grid[1, 2] + grid[2, 3]);
            Console.WriteLine(grid.Length + " " + grid.Rank + " " + grid.GetLength(1));
            var m = new int[,] { { 1, 2, 3 }, { 4, 5, 6 } };
            Console.WriteLine(Sum(m));
            int[,] n = { { 1, 2 }, { 3, 4 } };
            foreach (var x in n) Console.Write(x + " ");
            Console.WriteLine();
            var alias = n;
            alias[0, 0] = 100;
            Console.WriteLine(n[0, 0]);
            string[,,] cube = new string[2, 2, 2];
            cube[1, 1, 1] = "deep";
            Console.WriteLine(cube[1, 1, 1] + cube.Length);
            try { Console.WriteLine(n[2, 0]); }
            catch (IndexOutOfRangeException) { Console.WriteLine("out of range"); }
            Console.WriteLine(n);
            double[,] d = new double[2, 2] { { 1.5, 2.5 }, { 3.5, 4.5 } };
            Console.WriteLine(d[1, 0]);
        }
    }
}
