using System;
using System.Collections.Generic;

namespace Demo
{
    class Node
    {
        public Node Left, Right;
        public string Name;
        public Node(Node l, Node r, string name) { Left = l; Right = r; Name = name; }
        public int Count() => Left == null ? 1 : 1 + Left.Count() + Right.Count();
    }

    abstract class Shape
    {
        public abstract double Area();
        public virtual string Kind() => "shape";
    }

    class Sq : Shape
    {
        double s;
        public Sq(double s) { this.s = s; }
        public override double Area() => s * s;
        public override string Kind() => "square";
    }

    class Program
    {
        static Node Make(int d) => d == 0 ? new Node(null, null, "leaf") : new Node(Make(d - 1), Make(d - 1), "n" + d);

        static void Main()
        {
            // an if / else-if / else chain assigns on every path
            for (int i = 0; i < 3; i++)
            {
                Shape s;
                if (i % 3 == 0) s = new Sq(1);
                else if (i % 3 == 1) s = new Sq(2);
                else s = new Sq(3);
                Console.WriteLine(s.Area());
            }
            // a sibling scope declares the same name again
            var shapes = new List<Shape> { new Sq(4) };
            foreach (var s in shapes) Console.WriteLine(s.Kind());

            // a shifted literal takes the count's int type
            int d = 3;
            int n = 1 << (d + 1);
            Console.WriteLine(n);

            // constructor arguments moved in; the strings stay intact
            var t = Make(3);
            Console.WriteLine(t.Count());
            Console.WriteLine(t.Name + " " + t.Left.Name + " " + t.Left.Left.Left.Name);
            string keep = "kept";
            var k = new Node(null, null, keep);
            Console.WriteLine(keep + " " + k.Name);

            // a null receiver still throws
            Node none = null;
            try { Console.WriteLine(none.Count()); }
            catch (NullReferenceException) { Console.WriteLine("null receiver"); }
            try { Console.WriteLine(t.Left.Left.Left.Left.Count()); }
            catch (NullReferenceException) { Console.WriteLine("null field receiver"); }
        }
    }
}
