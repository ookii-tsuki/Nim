// Parameter modifiers (ref, out, in, params), optional and named arguments,
// lambdas passed to user and library methods, local functions, method groups,
// Action/Func delegates and several declarators in one declaration.
using System;
using System.Collections.Generic;

namespace Demo
{
    class Counter
    {
        int n;
        public int Bump(int by) { n += by; return n; }
    }

    class Program
    {
        static void Swap(ref int a, ref int b) { int t = a; a = b; b = t; }
        static bool TryHalf(int x, out int half)
        {
            if (x % 2 == 0) { half = x / 2; return true; }
            half = 0;
            return false;
        }
        static int Peek(in int x) { return x + 1; }
        static int Sum(params int[] xs) { int s = 0; foreach (int x in xs) s += x; return s; }
        static string Greet(string name, string greeting = "Hello", int times = 1)
        {
            string s = "";
            for (int i = 0; i < times; i++) s += greeting + " " + name + ";";
            return s;
        }
        static int Apply(Func<int, int> f, int x) { return f(x); }

        static void Main()
        {
            int a = 1, b = 2;
            Swap(ref a, ref b);
            Console.WriteLine(a + "," + b);
            if (TryHalf(10, out int h)) Console.WriteLine(h);
            int h2;
            Console.WriteLine(TryHalf(7, out h2) + " " + h2);
            Console.WriteLine(Peek(4));
            Console.WriteLine(Sum());
            Console.WriteLine(Sum(1, 2, 3));
            Console.WriteLine(Sum(new int[] { 4, 5 }));
            Console.WriteLine(Greet("ann"));
            Console.WriteLine(Greet("bob", "Hi"));
            Console.WriteLine(Greet("cy", times: 2));
            Console.WriteLine(Greet(greeting: "Yo", name: "dee"));
            Console.WriteLine(Apply(x => x * 3, 5));
            Console.WriteLine(Apply((int x) => { return x - 1; }, 5));
            int k = 10;
            Func<int, int> addK = x => x + k;
            Console.WriteLine(addK(1));
            List<int> xs = new List<int>();
            xs.Add(5); xs.Add(8); xs.Add(3);
            Console.WriteLine(xs.Find(x => x > 4));
            Console.WriteLine(xs.FindAll(x => x % 2 == 1).Count);
            xs.Sort((p, q) => q.CompareTo(p));
            Console.WriteLine(xs[0]);
            int Square(int v) => v * v;
            int Fact(int v) { return v <= 1 ? 1 : v * Fact(v - 1); }
            Console.WriteLine(Square(7) + Fact(5));
            Counter c = new Counter();
            Func<int, int> bump = c.Bump;
            bump(2);
            Console.WriteLine(bump(3));
            Action hello = () => Console.WriteLine("hello");
            hello();
            Action<string> say = s => Console.WriteLine(s);
            say("said");
            Func<int, int, int> add = (p, q) => p + q;
            Console.WriteLine(add(2, 3));
        }
    }
}
