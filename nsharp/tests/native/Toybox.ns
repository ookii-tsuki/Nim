// The N# binding of toybox/toybox.hpp: C# declarations whose members are
// `extern`, each naming the C++ it stands for.
using NSharp.Interop;

namespace Toybox
{
    [Native("Toybox::Vec2", Header = "toybox.hpp")]
    public struct Vec2
    {
        public float x;
        public float y;
        public extern Vec2(float x, float y);
        public static extern Vec2 Zero { get; }
        public static extern Vec2 operator +(Vec2 a, Vec2 b);
        public static extern Vec2 operator *(Vec2 a, float s);
    }

    [Native("Toybox::Console", Header = "toybox.hpp", Stable = true)]
    public static class Console
    {
        [Native("Toybox::Console::Print(\"%s\", @)")]
        public static extern void Print(string text);
    }

    [Native("Toybox::Trait", Header = "toybox.hpp", Handle = "Toybox::TraitRef<{0}>")]
    public class Trait
    {
    }

    [Native("Toybox::Motion", Header = "toybox.hpp")]
    public class Motion : Trait
    {
        public Vec2 Pos;
        public Vec2 Vel;
        public extern void Push(Vec2 force);
        [Native(Get = "GetPosition", Set = "SetPosition")]
        public extern Vec2 Position { get; set; }
        [Native(Get = "get_spin", Set = "set_spin")]
        public extern float Spin { get; set; }
        [Native(Get = "#->Vel.x")]
        public extern float Speed { get; }
        [Native(Get = "#->Describe().c_str()")]
        public extern string Description { get; }
        [Native(Get = "Describe")]
        public extern string Summary { [return: CString("#.c_str()")] get; }
    }

    [Native("Toybox::Tag", Header = "toybox.hpp")]
    public class Tag : Trait
    {
        public int Value;
    }

    [Native("Toybox::Node", Header = "toybox.hpp", Handle = "Toybox::NodeRef<{0}>", SelfHandle = "#->Self()")]
    public class Node
    {
        public extern T Attach<T>() where T : Trait;
        public extern T Find<T>() where T : Trait;
        public extern int Weigh<T>([CString("Toybox::Text::Str(#, #len)")] string tag) where T : Trait;
        [OnHandle] public extern uint Slot();
        [OnHandle, Native(Get = "#.version")] public extern uint Version { get; }
    }

    [Native("Toybox::Plaque", Header = "toybox.hpp")]
    public class Plaque : Node
    {
        public int size;
        public extern Plaque(string text, int size);
        [Native(Get = "#->text.c_str()")] public extern string Text { get; }
    }

    [Native("Toybox::Stage", Header = "toybox.hpp", Stable = true)]
    public class Stage
    {
        public virtual extern void Begin();
        public virtual extern void Tick(float dt);
        [Moves] public extern T Spawn<T>([Forward] params object[] args) where T : Node;
        [Moves] public extern void Remove(Node node);
    }

    [Native("Toybox::Director", Header = "toybox.hpp")]
    public static class Director
    {
        [Native(Get = "GetTimeScale", Set = "SetTimeScale")]
        public static extern float TimeScale { get; set; }
        public static extern void Play<T>() where T : Stage;
    }

    [Native("Toybox::Timer", Header = "toybox.hpp", Handle = "Toybox::TimerId<{0}>",
            Valid = "Toybox::Timers::Alive(#)", Null = "Toybox::TimerId<{0}>::None()",
            Deref = "#.Get()")]
    public class Timer
    {
        public float left;
        public int fired;
        [OnHandle, Native(Get = "Id")] public extern uint Id { get; }
        [OnHandle, Native("#.id")] public extern uint RawId();
    }

    [Native("Toybox::Timers", Header = "toybox.hpp")]
    public static class Timers
    {
        public static extern Timer Start(float seconds);
        public static extern void Stop(Timer timer);
    }

    [Native("Toybox::Palette", Header = "toybox.hpp")]
    public class Palette
    {
        public int colors;
        public int touched;
        public extern Palette();
        public extern Palette(string name, int colors);
        public virtual extern int Weight();
        [Native(Qualifiers = "const")] public virtual extern int Shade();
        [Native(Qualifiers = "noexcept")] public virtual extern void Touch();
        [Native(Qualifiers = "const")] public extern int Hue();
        public extern void Fade();
    }

    [Native("Toybox::Painter", Header = "toybox.hpp")]
    public static class Painter
    {
        public static extern int Count(Palette palette);
        public static extern int Weigh(Palette palette);
        public static extern int Live();
        public static extern int ShadeOf(Palette palette);
        public static extern void TouchOf(Palette palette);
        public static extern Palette Make(string name, int colors);
        public static extern Palette Copy(Palette palette);
        [return: Borrowed] public static extern Palette Shared();
        [return: Borrowed] public static extern Palette Find(int colors);
        [return: Owned] public static extern Palette Create(string name, int colors);
        [return: Owned]
        public static extern T Build<T>([Forward] params object[] args) where T : Palette;

        // The same, as properties: the getter's own [return: ...] says what it is.
        [Native(Get = "Shared")]
        public static extern Palette Featured { [return: Borrowed] get; }
        [Native(Get = "Toybox::Painter::Make(\"fresh\", 2)")]
        public static extern Palette Fresh { get; }
        [Native(Get = "Toybox::Painter::Create(\"spare\", 3)")]
        public static extern Palette Spare { [return: Owned] get; }
    }

    [Native("Toybox::Labels", Header = "toybox.hpp")]
    public static class Labels
    {
        public static extern string Plain();
        public static extern string Nothing();
        [return: CString("#.c_str()")] public static extern string Built(int k);
        [return: CString("#.Data()", Length = "#.Size()")] public static extern string Custom();
        public static extern int Measure([CString("Toybox::Text::Str(#, #len)")] string s);
        [return: CString("#.c_str()")]
        public static extern string Join([CString("Toybox::Text::Str::From(#)")] string a, int sep,
                                         [CString("Toybox::Text::Str(#, #len)")] string b);
    }

    [Native("Toybox::Grid", Header = "toybox.hpp")]
    public class Grid
    {
        public extern Grid(int w, int h);
        [Native(Get = "GetCell", Set = "SetCell")]
        public extern float this[int x, int y] { get; set; }
        [Native(Get = "#->cells[#]", Set = "#->cells[#] = #")]
        public extern float this[int i] { get; set; }
    }
}
