// The N# binding of toybox/toybox.hpp: C# declarations whose members are
// `extern`, each naming the C++ it stands for.
using NSharp.Interop;

namespace Toybox
{
    [Native("Toybox::Vec2", Header = "toybox.hpp")]
    public struct Vec2
    {
        public float x;
        public float y;
        public extern Vec2(float x, float y);
        public static extern Vec2 Zero { get; }
        public static extern Vec2 operator +(Vec2 a, Vec2 b);
        public static extern Vec2 operator *(Vec2 a, float s);
    }

    [Native("Toybox::Console", Header = "toybox.hpp")]
    public static class Console
    {
        [Native("Toybox::Console::Print(\"%s\", @)")]
        public static extern void Print(string text);
    }

    [Native("Toybox::Trait", Header = "toybox.hpp", Handle = "Toybox::TraitRef<{0}>")]
    public class Trait
    {
    }

    [Native("Toybox::Motion", Header = "toybox.hpp")]
    public class Motion : Trait
    {
        public Vec2 Pos;
        public Vec2 Vel;
        public extern void Push(Vec2 force);
    }

    [Native("Toybox::Tag", Header = "toybox.hpp")]
    public class Tag : Trait
    {
        public int Value;
    }

    [Native("Toybox::Node", Header = "toybox.hpp", Handle = "Toybox::NodeRef<{0}>", SelfHandle = "#->Self()")]
    public class Node
    {
        public extern T Attach<T>() where T : Trait;
        public extern T Find<T>() where T : Trait;
    }

    [Native("Toybox::Stage", Header = "toybox.hpp")]
    public class Stage
    {
        public virtual extern void Begin();
        public virtual extern void Tick(float dt);
        public extern T Spawn<T>([Forward] params object[] args) where T : Node;
        public extern void Remove(Node node);
    }

    [Native("Toybox::Director", Header = "toybox.hpp")]
    public static class Director
    {
        public static extern void Play<T>() where T : Stage;
    }

    [Native("Toybox::Timer", Header = "toybox.hpp", Handle = "Toybox::TimerId<{0}>",
            Valid = "Toybox::Timers::Alive(#)", Null = "Toybox::TimerId<{0}>::None()")]
    public class Timer
    {
        public float left;
        public int fired;
    }

    [Native("Toybox::Timers", Header = "toybox.hpp")]
    public static class Timers
    {
        public static extern Timer Start(float seconds);
        public static extern void Stop(Timer timer);
    }

    [Native("Toybox::Palette", Header = "toybox.hpp")]
    public class Palette
    {
        public int colors;
        public extern Palette();
        public extern Palette(string name, int colors);
        public virtual extern int Weight();
    }

    [Native("Toybox::Painter", Header = "toybox.hpp")]
    public static class Painter
    {
        public static extern int Count(Palette palette);
        public static extern int Weigh(Palette palette);
        public static extern int Live();
        public static extern Palette Make(string name, int colors);
        public static extern Palette Copy(Palette palette);
        [return: Borrowed] public static extern Palette Shared();
        [return: Borrowed] public static extern Palette Find(int colors);
        [return: Owned] public static extern Palette Create(string name, int colors);
    }
}
