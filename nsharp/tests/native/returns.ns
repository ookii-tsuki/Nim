using NSharp.Interop;
using Toybox;

namespace Demo
{
    // What C++ returns: by value it is N#'s own (boxed), `[return: Borrowed]` is lent
    // and stays C++'s, `[return: Owned]` is handed over and deleted by N#.
    static class Entry
    {
        static void ByValue()
        {
            Palette made = Painter.Make("made", 4);
            Console.Print($"by value: colors {made.colors}, live {Painter.Live()}");
        }

        static void Handed()
        {
            Palette mine = Painter.Create("created", 6);
            Console.Print($"owned: colors {mine.colors}, live {Painter.Live()}");
        }

        [Export("nsStart")]
        public static void Start()
        {
            ByValue();
            Console.Print($"after by value: live {Painter.Live()}");
            Handed();
            Console.Print($"after owned: live {Painter.Live()}");

            Palette lent = Painter.Shared();
            lent.colors = 9;
            Palette found = Painter.Find(9);
            Palette missing = Painter.Find(3);
            Console.Print($"borrowed: same {lent == found}, missing {missing == null}, live {Painter.Live()}");

            // Keeping one: a copy N# owns, made from the borrowed one.
            Palette kept = Painter.Copy(lent);
            Console.Print($"copy: colors {kept.colors}, live {Painter.Live()}, count {Painter.Count(kept)}");
            lent = null;
            found = null;
            Console.Print($"borrowed dropped: live {Painter.Live()}");
            kept = null;
            Console.Print($"copy dropped: live {Painter.Live()}");

            // As properties.
            Console.Print($"featured: same {Painter.Featured == Painter.Shared()}, live {Painter.Live()}");
            Palette fresh = Painter.Fresh;
            Palette spare = Painter.Spare;
            Console.Print($"fresh {fresh.colors}, spare {spare.colors}, live {Painter.Live()}");
            fresh = null;
            spare = null;
            Console.Print($"property ones dropped: live {Painter.Live()}");

            // A forwarding factory handing over what it builds.
            Palette built = Painter.Build<Palette>("built", 5);
            Console.Print($"built {built.colors}, live {Painter.Live()}");
            built = null;
            Console.Print($"built dropped: live {Painter.Live()}");
        }
    }
}
