using System;
using System.Collections.Generic;
using NSharp.Interop;
using Toybox;

namespace Demo
{
    // Constructors the engine runs: Spawn<T>(args) forwards its arguments to them.
    class Crate : Node
    {
        string label = "plain";
        List<string> tags = new List<string>();
        int count;
        float scale = 1.0f;

        public Crate() { tags.Add("default"); }

        public Crate(string label, int count)
        {
            this.label = label;
            this.count = count;
            tags.Add("labelled");
        }

        public Crate(string label, int count, float scale) : base()
        {
            this.label = label;
            this.count = count;
            this.scale = scale;
            for (int i = 0; i < count; i++) tags.Add($"{label}{i}");
        }

        void OnBegin() => Yard.Crates.Add(this);

        public string Describe()
        {
            string text = $"{label} x{count} at {(int)(scale * 10)}:";
            foreach (var t in tags) text += " " + t;
            return text;
        }
    }

    class Yard : Stage
    {
        public static List<Node> Crates = new List<Node>();

        public override void Begin()
        {
            string name = "iron";
            Spawn<Crate>();
            Spawn<Crate>("gold", 3);
            Spawn<Crate>(name + "!", 2, 2.5f);
            Spawn<Crate>("tin", 1);
            foreach (var n in Crates) Console.Print(((Crate)n).Describe());
        }

        public override void Tick(float dt) { }
    }

    static class Entry
    {
        [Export("nsStart")]
        public static void Start() => Director.Play<Yard>();
    }
}
