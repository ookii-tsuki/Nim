<Project Sdk="Microsoft.NET.Sdk">
  <!-- The semantic conformance oracle's Roslyn half. It references the compiler
       assemblies that ship inside the SDK itself ($(MSBuildSDKsPath)/../Roslyn/
       bincore), so it needs no NuGet feed and no machine-specific path, the same
       way nsharp/tests/run_cs.sh leans on the SDK that is already present. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>nsoracle</AssemblyName>
    <RootNamespace>nsoracle</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
